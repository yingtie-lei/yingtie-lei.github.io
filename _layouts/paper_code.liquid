---
---
<article class="paper-code" aria-labelledby="paper-title-{{ entry.key | escape }}">
  <h3 id="paper-title-{{ entry.key | escape }}" class="paper-code__title">{{ entry.title | escape }}</h3>
  <p class="paper-code__authors">
    {%- for author in entry.author_array -%}
      {%- assign clean_last_name = author.last | remove: '*' -%}
      {%- if site.scholar.last_name contains clean_last_name and site.scholar.first_name contains author.first -%}
        <strong>
          {{- author.first | escape }}
          {{ author.last | escape -}}
        </strong>
      {%- else -%}
        {{- author.first | escape }}
        {{ author.last | escape -}}
      {%- endif -%}
      {%- unless forloop.last %}, {% endunless -%}
    {%- endfor -%}
  </p>
  <p class="paper-code__venue">
    {% if entry.eprint %}
      {{ entry.archiveprefix | default: 'arXiv' | escape }} preprint {{ entry.archiveprefix | default: 'arXiv' | escape }}:{{ entry.eprint | escape }}
    {% else %}
      {{ entry.abbr | default: entry.booktitle | default: entry.journal | escape }}
    {%- endif -%}
    {%- if entry.year %}, {{ entry.year | escape }}{% endif %}
  </p>
  <nav class="paper-code__links" aria-label="Links for {{ entry.title | escape }}">
    {% if entry.html -%}
      <a href="{{ entry.html | escape }}">[Paper]</a>
    {%- endif %}
    {% if entry.pdf %}
      {% if entry.pdf contains '://' -%}
        {%- assign pdf_url = entry.pdf -%}
      {%- else -%}
        {%- assign pdf_url = entry.pdf | prepend: '/assets/pdf/' | relative_url -%}
      {%- endif %}
      <a href="{{ pdf_url | escape }}">[PDF]</a>
    {% endif %}
    {% if entry.arxiv -%}
      <a href="https://arxiv.org/abs/{{ entry.arxiv | escape }}">[arXiv]</a>
    {%- endif %}
    {% if entry.doi -%}
      <a href="https://doi.org/{{ entry.doi | escape }}">[DOI]</a>
    {%- endif %}
    {% if entry.code -%}
      <a href="{{ entry.code | escape }}">[Code]</a>
    {%- endif %}
    {% if entry.website -%}
      <a href="{{ entry.website | escape }}">[Project]</a>
    {%- endif %}
    <button
      type="button"
      class="paper-code__copy"
      data-copy-bibtex="bibtex-{{ entry.key | escape }}"
      aria-label="Copy BibTeX for {{ entry.title | escape }}"
    >
      [BibTeX]
    </button>
    <span class="paper-code__copy-status" role="status" aria-live="polite"></span>
  </nav>
  <pre id="bibtex-{{ entry.key | escape }}" class="paper-code__citation" hidden>{{- entry.bibtex | hideCustomBibtex | escape -}}</pre>
</article>
