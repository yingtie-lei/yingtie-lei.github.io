---
layout: null
---
<!doctype html>
<html lang="{{ site.lang | default: 'en' }}" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {{ site.first_name | escape }}
      {{ site.last_name | escape }}
      {% if page.native_name %} ({{ page.native_name | escape }}){% endif %}
    </title>
    <meta name="description" content="{{ site.description | strip | escape }}">
    <meta name="author" content="{{ site.first_name | escape }} {{ site.last_name | escape }}">
    {% if site.google_site_verification and site.google_site_verification != '' %}
      <meta name="google-site-verification" content="{{ site.google_site_verification | escape }}">
    {% endif %}
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="icon" href="{{ '/assets/img/site-logo-favicon.png' | relative_url }}">
    <link rel="apple-touch-icon" href="{{ '/assets/img/site-logo.png' | relative_url }}">
    <meta property="og:title" content="{{ site.first_name | escape }} {{ site.last_name | escape }}">
    <meta property="og:description" content="{{ site.description | strip | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ '/assets/img/og.png' | absolute_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/home.css' | relative_url | bust_file_cache }}">
  </head>
  <body class="home-page">
    <main class="home-main">
      <div class="academic-home">
        <article>
          <section class="academic-hero" aria-labelledby="academic-home-name">
            {% if page.profile and page.profile.image %}
              <div class="academic-hero__portrait">
                {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
                <img
                  src="{{ profile_image_path | relative_url }}"
                  width="160"
                  height="160"
                  alt="Portrait of {{ site.first_name | escape }} {{ site.last_name | escape }}"
                  fetchpriority="high"
                >
              </div>
            {% endif %}
            <div class="academic-hero__intro">
              <h1 id="academic-home-name" class="academic-hero__name">
                {% if site.title == 'blank' %}
                  {{ site.first_name }}
                  {{ site.middle_name }}
                  {{ site.last_name }}
                {% else %}
                  {{ site.title }}
                {% endif %}
                {% if page.native_name -%}
                  <span class="academic-hero__native-name">({{ page.native_name }})</span>
                {%- endif %}
              </h1>
              {% if page.social %}
                <nav class="academic-social" aria-label="Academic and social profiles">
                  {% if site.data.socials.scholar_userid %}
                    <a
                      href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid | escape }}"
                      aria-label="Google Scholar"
                      title="Google Scholar"
                    >
                      <svg viewBox="-64 0 512 512" width="20" height="20" aria-hidden="true" focusable="false">
                        <use href="{{ '/assets/icons/google-scholar.svg' | relative_url }}#scholar-icon"/>
                      </svg>
                    </a>
                  {% endif %}
                  {% if site.data.socials.linkedin_username %}
                    <a
                      href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username | escape }}/"
                      aria-label="LinkedIn"
                      title="LinkedIn"
                    >
                      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                        <path fill-rule="evenodd" d="M5 0h14a5 5 0 0 1 5 5v14a5 5 0 0 1-5 5H5a5 5 0 0 1-5-5V5a5 5 0 0 1 5-5ZM20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124ZM7.119 20.452H3.555V9h3.564Z"/>
                      </svg>
                    </a>
                  {% endif %}
                  {% if site.data.socials.email %}
                    <a href="mailto:{{ site.data.socials.email | escape }}" aria-label="Email" title="Email">
                      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                        <rect x="2" y="4" width="20" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2"/>
                        <path d="m3 5 9 7 9-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  {% endif %}
                </nav>
              {% endif %}
            </div>
          </section>

          <div class="academic-bio">{{ content }}</div>

          <section class="academic-research" aria-label="Research papers" data-paper-disclosures>
            <div class="academic-research__controls" aria-label="Paper categories">
              <button
                type="button"
                id="publications-tab"
                aria-controls="publications-panel"
                aria-expanded="false"
                data-paper-toggle="publications-panel"
              >
                Publications
              </button>
              <button type="button" id="preprint-tab" aria-controls="preprint-panel" aria-expanded="false" data-paper-toggle="preprint-panel">
                Preprints
              </button>
            </div>

            <section id="publications-panel" class="academic-research__panel" aria-labelledby="publications-heading" hidden>
              <h2 id="publications-heading">Publications</h2>
              <p class="academic-research__note">* denotes equal contribution.</p>
              {% capture publications %}{% bibliography --template paper_code --group_by none --query @*[preprint!=true] %}{% endcapture %}
              {% if publications contains '<li' %}
                {{ publications }}
              {% else %}
                <p class="academic-research__empty">No publications to display yet.</p>
              {% endif %}
            </section>

            <section id="preprint-panel" class="academic-research__panel" aria-labelledby="preprint-heading" hidden>
              <h2 id="preprint-heading">Preprints</h2>
              {% capture preprints %}{% bibliography --template paper_code --group_by none --query @*[preprint=true] %}{% endcapture %}
              {% if preprints contains '<li' %}
                <p class="academic-research__note">* denotes equal contribution.</p>
                {{ preprints }}
              {% else %}
                <p class="academic-research__empty">No preprints to display yet.</p>
              {% endif %}
            </section>
          </section>
        </article>
      </div>
    </main>
    <footer class="home-footer">
      &copy; {{ site.time | date: '%Y' }}
      {{ site.first_name | escape }}
      {{ site.last_name | escape }}
    </footer>
    <script src="{{ '/assets/js/paper-tabs.js' | relative_url | bust_file_cache }}" defer></script>
  </body>
</html>
